{
	"name": "confediliziacomo.it",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate": "node --env-file-if-exists=.env scripts/db/migrate.ts",
		"db:reset": "node --env-file-if-exists=.env scripts/db/reset.ts",
		"db:fresh": "npm run db:reset && npm run db:migrate",
		"db:create-user": "node --env-file-if-exists=.env scripts/db/create-user.ts",
		"test": "node --test \"src/**/*.test.ts\""
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.59.0",
		"@sveltejs/adapter-netlify": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/nodemailer": "^8.0.2",
		"@types/pdfmake": "^0.3.3",
		"bits-ui": "^2.19.5",
		"cn": "^0.4.0",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^10.3.1",
		"pdfmake": "^0.3.11",
		"postgres": "^3.4.9",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
