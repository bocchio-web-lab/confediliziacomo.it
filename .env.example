# This is an example environment file. Copy this file to .env and fill in the values.
# DATABASE_URL is used by the app at runtime.
DATABASE_URL=postgresql://db_user:db_password@server:5432/db_name
# DATABASE_URL_UNPOOLED is used by the scripts in `scripts/db` (migrations, users).
# It can be left empty to reuse DATABASE_URL.
DATABASE_URL_UNPOOLED=
