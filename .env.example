# This is an example environment file. Copy this file to .env and fill in the values.
# See README.md for how to create the Neon project and where each value is used.

# --- Database -------------------------------------------------------------------------------
# Pooled connection (host contains "-pooler"): used by the app at runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/confediliziacomo?sslmode=require

# Direct connection (no "-pooler"): used by the scripts in `scripts/db` (migrations, users).
# It can be left empty to reuse DATABASE_URL, but migrations should not go through the pooler.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/confediliziacomo?sslmode=require

# --- Sign up ---------------------------------------------------------------------------------
# Secret code to give to the people who may create an account. Without it the registration
# page is disabled (accounts can still be created with `npm run db:create-user`).
REGISTRATION_CODE=

# --- Emails (password reset) -----------------------------------------------------------------
# Public address of the site, used in the links of the emails (e.g. https://example.netlify.app).
# Empty: the address of the request is used.
SITE_URL=
# Mail server. Without SMTP_HOST and SMTP_FROM no email is sent (in development the message,
# with its link, is printed in the terminal instead).
SMTP_HOST=
# 465 uses TLS, any other port STARTTLS. Empty: 587.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Sender, e.g. Confedilizia Como <info@confediliziacomo.it>
SMTP_FROM=
